{
  "name": "vos-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5173",
    "build": "bun run scripts/assert-build-mode.ts production && tsc --noEmit -p tsconfig.json && vite build",
    "build:demo": "bun run scripts/assert-build-mode.ts demo && tsc --noEmit -p tsconfig.json && vite build --mode demo",
    "serve": "bun run server/main.ts serve",
    "worker": "bun run server/main.ts worker",
    "migrate": "bun run server/main.ts migrate",
    "seed": "bun run server/main.ts seed",
    "gc": "bun run server/main.ts gc",
    "test": "bun test",
    "test:teaching:connected": "node --experimental-strip-types scripts/run-connected-teaching-test.ts",
    "test:runner:connected": "node --experimental-strip-types scripts/run-connected-teaching-test.ts runner-load",
    "test:postgres": "bun test tests/postgres.integration.test.ts",
    "test:gitea": "bun test tests/gitea.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@tanstack/react-query": "^5.90.11",
    "@vitejs/plugin-react": "^5.1.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "dockerode": "^4.0.7",
    "i18next": "^26.3.6",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.4",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1",
    "tailwind-merge": "^2.6.0",
    "vite": "^7.2.7",
    "vos-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dockerode": "^3.3.38",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jose": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
