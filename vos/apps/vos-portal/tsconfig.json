{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["client", "demo", "domain", "server", "storage", "worker", "scripts", "vite.config.ts"]
}
